# Public site URL (used for canonical, OG images and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://ropona.studio

# Google Analytics 4 — loads only after cookie consent
NEXT_PUBLIC_GA_ID=

# Contact form delivery (Resend). Optional: without it, briefs are validated
# and logged with PII redacted.
RESEND_API_KEY=
CONTACT_TO=hello@ropona.studio
CONTACT_FROM="Ropona Studio <briefs@ropona.studio>"
